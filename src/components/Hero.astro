---
const base = import.meta.env.BASE_URL;
---
<section class="hero">
  <!-- アニメ調ドットグリッド背景 -->
  <div class="anime-bg-dots"></div>

  <div class="hero-inner">
    <!-- ロゴ表示エリア -->
    <div class="logo-area">
      <div class="logo-ring"></div>
      <img src={`${base}/logo.png`} alt="東北生徒会連合 ロゴ" class="hero-logo" />
    </div>

    <div class="org-sub">
      <span class="sparkle left">✦</span>
      TSU
      <span class="sparkle right">✦</span>
    </div>

    <!-- メインタイトル（アニメ風マーカー付き） -->
    <h1 class="title-wrap">
      <span class="title-main">
        <span class="marker-text">つながる東北生徒会</span>
        <span class="anime-deco deco-1">✦</span>
        <span class="anime-deco deco-2">✧</span>
      </span>
    </h1>

    <p class="lead">
      東北地方の生徒会外務活動を推進する学生団体
    </p>

    <div class="cta-wrapper">
      <a href="https://forms.google.com" target="_blank" rel="noopener noreferrer" class="btn-primary">
        参加フォームはこちら →
      </a>
      <a href={`${base}/#about`} class="btn-secondary">
        ABOUT
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: 5.5rem 1.5rem 4.5rem;
    background: #ffffff;
    border-bottom: 2px solid #e2e8f0;
    text-align: center;
    overflow: hidden;
  }

  /* アニメ・トーン風のドットパターン背景 */
  .anime-bg-dots {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(#2298b8 1.2px, transparent 1.2px);
    background-size: 24px 24px;
    opacity: 0.12;
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    max-width: 800px;
    margin: 0 auto;
    z-index: 10;
  }

  /* ロゴ周りのアニメ調リング */
  .logo-area {
    position: relative;
    display: inline-block;
    margin-bottom: 1rem;
  }
  .logo-ring {
    position: absolute;
    inset: -6px;
    border-radius: 50%;
    border: 3px dashed #2298b8;
    opacity: 0.5;
    animation: rotateRing 20s linear infinite;
  }
  @keyframes rotateRing {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
  .hero-logo {
    position: relative;
    width: 110px;
    height: 110px;
    border-radius: 50%;
    border: 4px solid #ffffff;
    box-shadow: 0 8px 24px rgba(34, 152, 184, 0.2);
    display: block;
  }

  /* サブタイトル TSU とキラキラ */
  .org-sub {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.15rem;
    font-weight: 900;
    letter-spacing: 0.25em;
    color: #2298b8;
    margin-bottom: 0.75rem;
  }
  .sparkle {
    font-size: 0.9rem;
    color: #f59e0b;
    animation: pulseSparkle 2s ease-in-out infinite alternate;
  }
  @keyframes pulseSparkle {
    0% { transform: scale(0.8) rotate(0deg); opacity: 0.7; }
    100% { transform: scale(1.25) rotate(15deg); opacity: 1; }
  }

  /* タイトル周り */
  .title-wrap {
    margin: 0 0 1.25rem;
  }
  .title-main {
    position: relative;
    display: inline-block;
    font-size: 3rem;
    font-weight: 900;
    color: #0f172a;
    letter-spacing: -0.01em;
    line-height: 1.25;
  }

  /* 蛍光マーカーアニメーション */
  .marker-text {
    position: relative;
    z-index: 2;
    background: linear-gradient(transparent 55%, #bbf7d0 55%, #86efac 92%, transparent 92%);
    background-size: 0% 100%;
    background-repeat: no-repeat;
    animation: markerDraw 1.2s cubic-bezier(0.25, 1, 0.5, 1) forwards 0.3s;
    padding: 0 0.2em;
    border-radius: 2px;
  }
  @keyframes markerDraw {
    to {
      background-size: 100% 100%;
    }
  }

  /* アニメ調のキラキラ装飾（右上・左下） */
  .anime-deco {
    position: absolute;
    color: #0284c7;
    pointer-events: none;
    user-select: none;
  }
  .deco-1 {
    top: -12px;
    right: -24px;
    font-size: 1.5rem;
    color: #38bdf8;
    animation: floatDeco 3s ease-in-out infinite alternate;
  }
  .deco-2 {
    bottom: -6px;
    left: -20px;
    font-size: 1.2rem;
    color: #f59e0b;
    animation: floatDeco 2.5s ease-in-out infinite alternate-reverse;
  }
  @keyframes floatDeco {
    0% { transform: translateY(0px) rotate(0deg); }
    100% { transform: translateY(-6px) rotate(20deg); }
  }

  .lead {
    font-size: 1.2rem;
    font-weight: 600;
    color: #475569;
    margin: 0 auto 2.5rem;
    line-height: 1.6;
  }

  /* ボタン */
  .cta-wrapper {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .btn-primary {
    display: inline-block;
    background: #2298b8;
    color: #ffffff;
    font-weight: 800;
    text-decoration: none;
    padding: 0.9rem 2rem;
    border-radius: 50px;
    box-shadow: 0 6px 16px rgba(34, 152, 184, 0.3);
    transition: all 0.2s ease;
    border: 2px solid #2298b8;
  }
  .btn-primary:hover {
    background: #1b7a94;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(34, 152, 184, 0.4);
  }
  .btn-secondary {
    display: inline-block;
    background: #ffffff;
    color: #334155;
    border: 2px solid #cbd5e1;
    font-weight: 800;
    text-decoration: none;
    padding: 0.9rem 1.75rem;
    border-radius: 50px;
    transition: all 0.2s ease;
  }
  .btn-secondary:hover {
    background: #f8fafc;
    border-color: #94a3b8;
  }

  /* スマホ対応 */
  @media (max-width: 640px) {
    .hero { padding: 3.5rem 1.25rem 3rem; }
    .hero-logo { width: 90px; height: 90px; }
    .title-main { font-size: 2rem; }
    .deco-1 { right: -12px; top: -8px; font-size: 1.2rem; }
    .deco-2 { left: -10px; bottom: -4px; font-size: 1rem; }
    .lead { font-size: 1rem; }
  }
</style>
