---
const base = import.meta.env.BASE_URL;
---
<section class="hero">
  <div class="hero-bg-accent"></div>
  <div class="hero-inner">
    <div class="logo-area">
      <img src={`${base}/logo.png`} alt="東北生徒会連合 ロゴ" class="hero-logo" />
    </div>

    <div class="org-sub">TSU</div>

    <h1 class="title">つながる東北生徒会</h1>

    <p class="lead">
      東北地方の生徒会外務活動を推進する学生団体
    </p>

    <div class="cta-wrapper">
      <a href="https://forms.google.com" target="_blank" rel="noopener noreferrer" class="btn-primary">
        参加フォームはこちら →
      </a>
      <a href={`${base}/#about`} class="btn-secondary">
        ABOUT
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: 5rem 1.5rem 4.5rem;
    background: linear-gradient(180deg, #f0fdf4 0%, #ffffff 100%);
    border-bottom: 1px solid #e2e8f0;
    text-align: center;
    overflow: hidden;
  }
  .hero-bg-accent {
    position: absolute;
    top: -80px;
    left: 50%;
    transform: translateX(-50%);
    width: 600px;
    height: 300px;
    background: radial-gradient(circle, rgba(34, 152, 184, 0.12) 0%, rgba(255,255,255,0) 70%);
    pointer-events: none;
  }
  .hero-inner {
    position: relative;
    max-width: 800px;
    margin: 0 auto;
  }
  .logo-area {
    margin-bottom: 1.25rem;
  }
  .hero-logo {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.1);
  }
  .org-sub {
    font-size: 1.1rem;
    font-weight: 800;
    letter-spacing: 0.2em;
    color: #2298b8;
    margin-bottom: 0.75rem;
  }
  .title {
    font-size: 2.75rem;
    font-weight: 900;
    color: #0f172a;
    line-height: 1.2;
    margin: 0 0 1.25rem;
    letter-spacing: -0.02em;
  }
  .lead {
    font-size: 1.2rem;
    font-weight: 500;
    color: #334155;
    margin: 0 auto 2.25rem;
    line-height: 1.6;
  }
  .cta-wrapper {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .btn-primary {
    display: inline-block;
    background: #2298b8;
    color: #ffffff;
    font-weight: 700;
    text-decoration: none;
    padding: 0.85rem 1.75rem;
    border-radius: 8px;
    box-shadow: 0 4px 12px rgba(34, 152, 184, 0.25);
    transition: all 0.2s ease;
  }
  .btn-primary:hover {
    background: #1b7a94;
    transform: translateY(-1px);
  }
  .btn-secondary {
    display: inline-block;
    background: #ffffff;
    color: #475569;
    border: 1px solid #cbd5e1;
    font-weight: 700;
    text-decoration: none;
    padding: 0.85rem 1.5rem;
    border-radius: 8px;
    transition: all 0.2s ease;
  }
  .btn-secondary:hover {
    background: #f8fafc;
    border-color: #94a3b8;
  }
  @media (max-width: 640px) {
    .hero { padding: 3.5rem 1.25rem 3rem; }
    .hero-logo { width: 96px; height: 96px; }
    .title { font-size: 2rem; }
    .lead { font-size: 1.05rem; }
  }
</style>
