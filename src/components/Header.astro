---
const base = import.meta.env.BASE_URL;
---
<header class="header">
  <div class="header-inner">
    <a href={`${base}/`} class="brand">
      <img src={`${base}/logo.png`} alt="東北生徒会連合 ロゴ" class="logo" />
      <span class="site-title">東北生徒会連合</span>
      <span class="demo-tag">DEMO</span>
    </a>
    <nav class="nav">
      <a href={`${base}/#about`}>概要</a>
      <a href={`${base}/#projects`}>事業</a>
      <a href={`${base}/#prefectures`}>各県連盟</a>
      <a href="https://forms.google.com" target="_blank" rel="noopener noreferrer" class="btn-join">参加フォーム</a>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid #e5e7eb;
  }
  .header-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0.75rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: #111827;
    font-weight: 700;
  }
  .logo {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    object-fit: cover;
  }
  .site-title {
    font-size: 1.15rem;
  }
  .demo-tag {
    background: #ef4444;
    color: white;
    font-size: 0.7rem;
    font-weight: 800;
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
    letter-spacing: 0.05em;
  }
  .nav {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }
  .nav a {
    text-decoration: none;
    color: #4b5563;
    font-size: 0.95rem;
    font-weight: 500;
    transition: color 0.2s;
  }
  .nav a:hover {
    color: #0284c7;
  }
  .btn-join {
    background: #fef08a !important;
    color: #854d0e !important;
    border: 1px solid #ca8a04;
    padding: 0.4rem 0.9rem;
    border-radius: 9999px;
    font-weight: 700 !important;
  }
  .btn-join:hover {
    background: #fde047 !important;
  }
  @media (max-width: 640px) {
    .site-title { font-size: 1rem; }
    .nav a:not(.btn-join) { display: none; }
  }
</style>
