---
import { prefectures } from '../data/prefectures';
const base = import.meta.env.BASE_URL;
---
<section id="prefectures" class="pref-section">
  <div class="container">
    <div class="section-label">NETWORK</div>
    <h2 class="section-title">各県連盟</h2>
    <p class="lead">各県の生徒会連盟一覧です。</p>

    <div class="pref-grid">
      {prefectures.map(pref => (
        <a href={`${base}/prefectures/${pref.id}`} class="pref-card">
          <div class="pref-top">
            <span class="pref-name">{pref.name}</span>
            <span class={`pref-status ${pref.active ? 'active' : 'prep'}`}>
              {pref.active ? '設立済み' : '準備中'}
            </span>
          </div>
          <div class="pref-org">{pref.orgName || '準備中'}</div>
          <div class="pref-arrow">詳細を見る →</div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .pref-section {
    padding: 4.5rem 1.5rem 5.5rem;
    background: #ffffff;
  }
  .container {
    max-width: 860px;
    margin: 0 auto;
  }
  .section-label {
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.15em;
    color: #2298b8;
    margin-bottom: 0.5rem;
  }
  .section-title {
    font-size: 2rem;
    font-weight: 800;
    color: #0f172a;
    margin: 0 0 0.5rem;
  }
  .lead {
    color: #64748b;
    font-size: 1rem;
    margin: 0 0 2rem;
  }
  .pref-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 1.25rem;
  }
  .pref-card {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 1.35rem;
    text-decoration: none;
    color: inherit;
    transition: all 0.2s ease;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .pref-card:hover {
    background: #ffffff;
    border-color: #2298b8;
    box-shadow: 0 4px 12px rgba(34, 152, 184, 0.1);
    transform: translateY(-2px);
  }
  .pref-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }
  .pref-name {
    font-size: 1.25rem;
    font-weight: 800;
    color: #0f172a;
  }
  .pref-status {
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.15rem 0.5rem;
    border-radius: 9999px;
  }
  .pref-status.active {
    background: #dcfce7;
    color: #166534;
  }
  .pref-status.prep {
    background: #e2e8f0;
    color: #64748b;
  }
  .pref-org {
    font-size: 0.92rem;
    color: #475569;
    margin-bottom: 1rem;
    min-height: 1.4em;
  }
  .pref-arrow {
    font-size: 0.85rem;
    font-weight: 700;
    color: #2298b8;
  }
</style>
