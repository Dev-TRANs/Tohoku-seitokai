---
import { prefectures } from '../data/prefectures';
const base = import.meta.env.BASE_URL;
---
<section id="prefectures" class="pref-section">
  <div class="container">
    <div class="section-badge-wrap">
      <span class="badge-icon">✦</span>
      <span class="section-label">NETWORK</span>
      <span class="badge-icon">✦</span>
    </div>
    <h2 class="section-title">各県連盟</h2>
    <p class="lead">各県の生徒会連盟一覧です。</p>

    <div class="pref-grid">
      {prefectures.map(pref => (
        <a href={`${base}/prefectures/${pref.id}`} class="pref-card">
          <div class="pref-top">
            <span class="pref-name">{pref.name}</span>
            <span class={`pref-status ${pref.active ? 'active' : 'prep'}`}>
              {pref.active ? '設立済み' : '準備中'}
            </span>
          </div>
          <div class="pref-org">{pref.orgName || '準備中'}</div>
          <div class="pref-arrow">詳細を見る →</div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .pref-section {
    padding: 5rem 1.5rem 6.5rem;
    position: relative;
  }
  .container {
    max-width: 860px;
    margin: 0 auto;
  }
  .section-badge-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-bottom: 0.4rem;
  }
  .badge-icon {
    color: #f59e0b;
    font-size: 0.85rem;
  }
  .section-label {
    font-size: 0.9rem;
    font-weight: 900;
    letter-spacing: 0.2em;
    color: #2298b8;
  }
  .section-title {
    font-size: 2.15rem;
    font-weight: 900;
    color: #0f172a;
    text-align: center;
    margin: 0 0 0.5rem;
  }
  .lead {
    color: #64748b;
    font-size: 1rem;
    font-weight: 600;
    text-align: center;
    margin: 0 0 2.5rem;
  }
  .pref-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 1.25rem;
  }
  .pref-card {
    background: #ffffff;
    border: 2.5px solid #e2e8f0;
    border-radius: 18px;
    padding: 1.35rem 1.5rem;
    text-decoration: none;
    color: inherit;
    box-shadow: 0 4px 0px #cbd5e1;
    transition: all 0.2s ease;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .pref-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 0px #94a3b8;
    border-color: #2298b8;
  }
  .pref-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }
  .pref-name {
    font-size: 1.35rem;
    font-weight: 900;
    color: #0f172a;
  }
  .pref-status {
    font-size: 0.75rem;
    font-weight: 800;
    padding: 0.2rem 0.6rem;
    border-radius: 50px;
  }
  .pref-status.active {
    background: #dcfce7;
    color: #166534;
    border: 1px solid #86efac;
  }
  .pref-status.prep {
    background: #f1f5f9;
    color: #64748b;
    border: 1px solid #cbd5e1;
  }
  .pref-org {
    font-size: 0.95rem;
    font-weight: 600;
    color: #475569;
    margin-bottom: 1.25rem;
    min-height: 1.5em;
  }
  .pref-arrow {
    font-size: 0.9rem;
    font-weight: 800;
    color: #2298b8;
  }
</style>
